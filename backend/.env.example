# Required environment variables for deployment
# Copy to .env for local development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API Configuration
PORT=3000
NODE_ENV=development

# EAS Endpoints
EAS_ENDPOINT_ARBITRUM=https://arbitrum.easscan.org/graphql
EAS_ENDPOINT_CELO=https://celo.easscan.org/graphql
EAS_ENDPOINT_SEPOLIA=https://sepolia.easscan.org/graphql
EAS_ENDPOINT_BASE=https://base.easscan.org/graphql

# EAS Schema UID
EAS_SCHEMA_UID=0xba4171c92572b1e4f241d044c32cdf083be9fd946b8766977558ca6378c824e2
EAS_SCHEMA_RAW_STRING="uint256 eventTimestamp,string srs,string locationType,string location,string[] recipeType,bytes[] recipePayload,string[] mediaType,string[] mediaData,string memo"

# Endpoint auth (each at least 16 characters; generate with `openssl rand -hex 32`)
# Routes guarded by a secret that is not set reject every request with 503.
# CRON_SECRET: Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/sync.
CRON_SECRET=
# SYNC_ADMIN_TOKEN: required as "Authorization: Bearer <token>" for POST /api/sync,
# /api/sync/revocations and /api/sync/worker (also accepted by /api/cron/sync).
SYNC_ADMIN_TOKEN=

# Optional settings
# The following can be adjusted as needed for your deployment
# Per-chain ingestion time budget per sync run (ms). Ingestion pages through EAS until
# caught up or this budget is spent, then resumes next run. Keep (budget x chains) plus
# revocation checks under the hosting function's max duration. Default: 8000
# INGEST_TIME_BUDGET_MS=8000
# SKIP_INITIAL_INGEST=true
# LOG_LEVEL=INFO
# Set to true to remove the POST /api/sync trigger endpoint entirely. Default: false
DISABLE_SYNC_TRIGGER=false